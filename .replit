modules = ["nodejs-20"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["apk-tools"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run html"

[[workflows.workflow]]
name = "Run html"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/curso-asincronismo/src/async-landing && ./node_modules/.bin/serve -p 5000"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
